<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="13122.16" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="ref-tt-ph0">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="13104.12"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <!--
    NOTE: The root UITabBarController + 4 UINavigationControllers are assembled
    programmatically in SceneDelegate (not as IB relationship segues here).
    ibtool in this Xcode version fails to resolve a "rootViewController"
    relationship segue that targets a Storyboard Reference: it either silently
    produces an empty UINavigationController (no sceneMemberID on the
    placeholder) or crashes the storyboard compiler outright (with
    sceneMemberID on the placeholder). SceneDelegate builds the tabs via
    UIStoryboard(name:), which resolves these same references correctly.
    -->
    <scenes>
        <!--Tanish Trips Storyboard Reference-->
        <scene sceneID="ref-tt-scn">
            <objects>
                <viewControllerPlaceholder storyboardName="TanishTrips" id="ref-tt-ph0"/>
            </objects>
            <point key="canvasLocation" x="139" y="132"/>
        </scene>
        <!--Joann Stops Storyboard Reference-->
        <scene sceneID="ref-js-scn">
            <objects>
                <viewControllerPlaceholder storyboardName="JoannStops" id="ref-js-ph0"/>
            </objects>
            <point key="canvasLocation" x="139" y="270"/>
        </scene>
        <!--Pratham Detail Explore Storyboard Reference-->
        <scene sceneID="ref-pd-scn">
            <objects>
                <viewControllerPlaceholder storyboardName="PrathamDetailExplore" id="ref-pd-ph0"/>
            </objects>
            <point key="canvasLocation" x="139" y="668"/>
        </scene>
        <!--Neel Map Settings Storyboard Reference (Map, initial VC)-->
        <scene sceneID="ref-nm-scn">
            <objects>
                <viewControllerPlaceholder storyboardName="NeelMapSettings" id="ref-nm-ph0"/>
            </objects>
            <point key="canvasLocation" x="139" y="400"/>
        </scene>
        <!--Neel Map Settings Storyboard Reference (Settings, non-initial VC)-->
        <scene sceneID="ref-ns-scn">
            <objects>
                <viewControllerPlaceholder storyboardName="NeelMapSettings" referencedIdentifier="SettingsVC" id="ref-ns-ph0"/>
            </objects>
            <point key="canvasLocation" x="139" y="936"/>
        </scene>
    </scenes>
</document>
